diff --git a/oan_auth_service/tests/test_reset_sms.py b/oan_auth_service/tests/test_reset_sms.py
new file mode 100644
index 0000000..72f84e7
--- /dev/null
+++ b/oan_auth_service/tests/test_reset_sms.py
@@ -0,0 +1,134 @@
+"""Password-reset codes by SMS through the OAN Messaging Service (api/reset_sms.py).
+
+Needs oan_messaging_connector on the test site; skipped otherwise. No network: the send
+itself is replaced, and the connector's own tests cover the HTTP side.
+"""
+
+import unittest
+from datetime import UTC, datetime, timedelta
+from unittest import mock
+
+import frappe
+
+from oan_auth_service.api import reset_sms
+from oan_auth_service.api.v1 import auth
+
+USER = "reset-sms-test@example.invalid"
+PHONE = "0900000721"
+
+
+def connector_installed() -> bool:
+	return reset_sms.CONNECTOR in frappe.get_installed_apps()
+
+
+@unittest.skipUnless(connector_installed(), "oan_messaging_connector is not installed")
+class TestResetSms(unittest.TestCase):
+	def setUp(self):
+		keys = ("oan_messaging_enabled", "oan_messaging_base_url", "oan_messaging_token")
+		self._conf = {k: frappe.conf.get(k) for k in keys}
+		frappe.conf.oan_messaging_enabled = 1
+		frappe.conf.oan_messaging_base_url = "https://oan-messaging.example.invalid"
+		frappe.conf.oan_messaging_token = "oanmsg_" + "t" * 43
+		self.addCleanup(self._restore)
+		for key in (auth._otp_issued_cache_key(USER), auth._otp_cache_key(USER)):
+			frappe.cache.delete_value(key)
+		self.errors_before = set(frappe.get_all("Error Log", pluck="name"))
+
+	def _restore(self):
+		for k, v in self._conf.items():
+			frappe.conf[k] = v
+		frappe.cache.delete_value(auth._otp_issued_cache_key(USER))
+		frappe.cache.delete_value(auth._otp_cache_key(USER))
+
+	def new_errors(self):
+		names = set(frappe.get_all("Error Log", pluck="name")) - self.errors_before
+		return [frappe.get_doc("Error Log", n) for n in names]
+
+	def job_args(self, **kw):
+		now = datetime.now(UTC)
+		args = {
+			"delivery_id": "2f1c7d0e-8b5a-4c3e-9a77-1d2e3f4a5b6c",
+			"reset_request_id": "test-request-1",
+			"phone": PHONE,
+			"text": "482913 is your password reset code. It expires in 10 minutes.",
+			"issued_at": now.isoformat(),
+			"expires_at": (now + timedelta(minutes=10)).isoformat(),
+		}
+		args.update(kw)
+		return args
+
+	# ------------------------------------------------------------ issuing the code
+
+	def test_oan_ready_follows_the_connector_settings(self):
+		self.assertTrue(reset_sms.oan_ready())
+		frappe.conf.oan_messaging_enabled = 0
+		self.assertFalse(reset_sms.oan_ready())
+
+	def test_reset_with_oan_enqueues_one_oan_job_and_never_frappes_sender(self):
+		with mock.patch.object(frappe, "enqueue") as enqueue:
+			auth._deliver_reset_by_sms(USER, PHONE)
+		self.assertEqual(enqueue.call_count, 1)
+		method, kwargs = enqueue.call_args.args[0], enqueue.call_args.kwargs
+		self.assertEqual(method, reset_sms.JOB)
+		self.assertTrue(kwargs["enqueue_after_commit"])
+		self.assertEqual(kwargs["phone"], PHONE)
+		self.assertRegex(kwargs["text"], r"^\d{6} is your password reset code")
+		self.assertIsNotNone(frappe.cache.get_value(auth._otp_cache_key(USER)))  # hash stored
+
+	def test_without_oan_or_gateway_no_code_is_issued(self):
+		frappe.conf.oan_messaging_enabled = 0
+		with (
+			mock.patch.object(auth, "_sms_gateway_configured", return_value=False),
+			mock.patch.object(frappe, "enqueue") as enqueue,
+		):
+			auth._deliver_reset_by_sms(USER, PHONE)
+		enqueue.assert_not_called()
+		self.assertIsNone(frappe.cache.get_value(auth._otp_cache_key(USER)))
+
+	def test_without_oan_frappes_sender_is_kept(self):
+		frappe.conf.oan_messaging_enabled = 0
+		with (
+			mock.patch.object(auth, "_sms_gateway_configured", return_value=True),
+			mock.patch.object(frappe, "enqueue") as enqueue,
+		):
+			auth._deliver_reset_by_sms(USER, PHONE)
+		self.assertEqual(enqueue.call_args.args[0].__name__, "_send_sms")
+
+	def test_sms_expiry_is_capped_at_the_otp_ceiling(self):
+		with mock.patch.object(frappe, "enqueue") as enqueue:
+			reset_sms.enqueue_reset_sms(PHONE, "123456 is your code.", ttl_seconds=3600)
+		kwargs = enqueue.call_args.kwargs
+		lifetime = datetime.fromisoformat(kwargs["expires_at"]) - datetime.fromisoformat(kwargs["issued_at"])
+		self.assertEqual(lifetime, reset_sms.MAX_OTP_SMS_LIFETIME)
+
+	# ------------------------------------------------------------ the send job
+
+	def test_job_sends_an_otp_with_the_issued_key_and_deadline(self):
+		args = self.job_args()
+		with mock.patch("oan_messaging_connector.send_now.send_sms_now") as send:
+			send.return_value.id = "0b9f3a52-5c1e-4d55-9b7a-3f1c2a7e9d10"
+			self.assertEqual(reset_sms.send_reset_sms(**args), "0b9f3a52-5c1e-4d55-9b7a-3f1c2a7e9d10")
+		sent = send.call_args.kwargs
+		self.assertEqual((sent["purpose"], sent["idempotency_key"]), ("otp", args["delivery_id"]))
+		self.assertEqual(sent["source_reference"], "auth:password-reset:test-request-1")
+		self.assertEqual(sent["expires_at"], datetime.fromisoformat(args["expires_at"]))
+
+	def test_job_failures_are_logged_without_code_or_phone(self):
+		from oan_messaging_connector.send_now import NotConfigured, OanRejected, OanUncertain
+
+		failures = (
+			NotConfigured("off"),
+			OanRejected(422, "validation_failed", ()),
+			OanUncertain("k" * 36, 2, "http_503"),
+			ValueError("text is empty or does not fit one SMS part"),
+			RuntimeError("anything else, holding 482913 and 0900000721"),
+		)
+		for exc in failures:
+			with mock.patch("oan_messaging_connector.send_now.send_sms_now", side_effect=exc):
+				self.assertIsNone(reset_sms.send_reset_sms(**self.job_args()))
+		errors = self.new_errors()
+		self.assertEqual(len(errors), len(failures))
+		for error in errors:
+			self.assertEqual(error.method, reset_sms.ERROR_TITLE)
+			self.assertNotIn("482913", error.error)
+			self.assertNotIn(PHONE, error.error)
