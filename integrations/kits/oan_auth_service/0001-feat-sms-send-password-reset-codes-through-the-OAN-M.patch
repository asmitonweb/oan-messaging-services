 	frappe.enqueue(
@@ -890,7 +904,7 @@ def _deliver_reset_by_sms(user: str, mobile_no: str) -> None:
 		queue="short",
 		enqueue_after_commit=True,
 		receiver_list=[mobile_no],
-		msg=_("{0} is your password reset code. It expires in {1} minutes.").format(otp, minutes),
