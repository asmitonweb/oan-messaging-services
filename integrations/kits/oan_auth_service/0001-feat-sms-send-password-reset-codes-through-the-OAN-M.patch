+++ b/oan_auth_service/api/reset_sms.py
@@ -0,0 +1,122 @@
+"""Password-reset codes by SMS through the OAN Messaging Service.
+
+Used when ``oan_messaging_connector`` is installed and configured on the site. Otherwise
+Auth keeps Frappe's own SMS sender (the gateway in SMS Settings, or a ``send_sms`` hook).
+
+The code is never stored by the connector and never logged: it travels only in the
+arguments of one background job, which runs after the request commits and sends at once
+with ``purpose="otp"``. Logs and the Error Log carry ``reset_request_id``, the OAN
+message id and error codes only.
+
+Delivery outcomes:
+
+* accepted by OAN: logged with the OAN id;
+* refused by OAN, OAN not configured, or an invalid message: an Error Log entry, no
+  code reaches the user;
+* still uncertain after the client's own retries (same key): an Error Log entry. The job
+  is not repeated: the code expires within minutes, and the user can ask for a new one
+  (within the daily cap).
+
+The requester's response never changes with any of these, as before.
+"""
+
+from __future__ import annotations
+
+import secrets
+import uuid
+from datetime import UTC, datetime, timedelta
+
+import frappe
+
+CONNECTOR = "oan_messaging_connector"
+JOB = "oan_auth_service.api.reset_sms.send_reset_sms"
+#: OAN refuses an OTP that may live longer than 30 minutes. A longer code TTL still
+#: works; only the SMS stops being sendable after 30 minutes.
+MAX_OTP_SMS_LIFETIME = timedelta(minutes=30)
+ERROR_TITLE = "Password reset SMS not sent"
+
+
+def oan_ready() -> bool:
+	"""Whether reset codes go through OAN Messaging on this site."""
+	if CONNECTOR not in frappe.get_installed_apps():
+		return False
+	from oan_messaging_connector.send_now import is_configured
+
+	return is_configured()
+
+
+def enqueue_reset_sms(mobile_no: str, text: str, ttl_seconds: int) -> str:
+	"""Queue one OTP send to run after the current transaction commits.
+
+	Returns the ``reset_request_id``, the only identifier safe to log.
+	"""
+	issued_at = datetime.now(UTC)
+	expires_at = issued_at + min(timedelta(seconds=ttl_seconds), MAX_OTP_SMS_LIFETIME)
+	reset_request_id = secrets.token_hex(8)
+	frappe.enqueue(
+		JOB,
+		queue="short",
+		enqueue_after_commit=True,
+		delivery_id=str(uuid.uuid4()),
+		reset_request_id=reset_request_id,
+		phone=mobile_no,
+		text=text,
+		issued_at=issued_at.isoformat(),
+		expires_at=expires_at.isoformat(),
+	)
+	return reset_request_id
+
+
+def send_reset_sms(
+	*,
+	delivery_id: str,
+	reset_request_id: str,
+	phone: str,
+	text: str,
+	issued_at: str,
+	expires_at: str,
+) -> str | None:
+	"""Background job: send the code now. Returns the OAN message id, or None."""
+	from oan_messaging_connector.send_now import (
+		NotConfigured,
+		OanRejected,
+		OanUncertain,
+		send_sms_now,
+	)
+
+	try:
+		submission = send_sms_now(
+			idempotency_key=delivery_id,
+			recipient=phone,
+			text=text,
+			source_reference=f"auth:password-reset:{reset_request_id}",
+			purpose="otp",
+			expires_at=datetime.fromisoformat(expires_at),
+			first_submitted_at=datetime.fromisoformat(issued_at),
+		)
+	except NotConfigured:
+		return _not_sent(reset_request_id, "oan_not_configured")
+	except OanRejected as exc:
+		return _not_sent(reset_request_id, f"oan_rejected:{exc.status}:{exc.code}")
+	except OanUncertain:
+		return _not_sent(reset_request_id, "oan_uncertain")
+	except Exception as exc:
+		# Anything else (protocol errors, an invalid message, the unexpected) is recorded
+		# by type only. Never let it escape: Frappe's job-failure log could then carry the
+		# job arguments, which hold the phone and, in the text, the code.
+		return _not_sent(reset_request_id, type(exc).__name__)
+
+	frappe.logger().info(
+		"Password reset SMS accepted by OAN: reset_request_id=%s oan_id=%s",
+		reset_request_id,
+		submission.id,
+	)
+	return submission.id
+
+
+def _not_sent(reset_request_id: str, reason: str) -> None:
+	frappe.log_error(
+		title=ERROR_TITLE,
+		message=f"reset_request_id={reset_request_id} reason={reason}",
+	)
+	return None
