@@ -883,6 +890,13 @@ def _deliver_reset_by_sms(user: str, mobile_no: str) -> None:
 	frappe.cache.delete_value(_otp_attempts_cache_key(user))
 
 	minutes = settings.password_reset_otp_ttl() // 60
+	text = _("{0} is your password reset code. It expires in {1} minutes.").format(otp, minutes)
+
