+import { describe, expect, it } from "vitest";
+import { SMS_MAX_PARTS, smsParts } from "./smsParts";
+
+// The same boundaries the OAN Messaging service enforces (oan_messaging.contracts.sms_parts).
+describe("smsParts", () => {
+  it.each([
+    ["", 1],
+    ["a".repeat(160), 1],
+    ["a".repeat(161), 2],
+    ["a".repeat(306), 2],
+    ["a".repeat(307), 3],
+    ["a".repeat(459), 3],
+    ["a".repeat(460), 4],
+    ["ቅ".repeat(70), 1],
+    ["ቅ".repeat(71), 2],
+    ["ቅ".repeat(201), 3],
+    ["ቅ".repeat(202), 4],
+    ["a".repeat(69) + "ቅ", 1],
+    ["a".repeat(70) + "ቅ", 2],
+    ["{".repeat(228) + "a", 3],
+    ["{".repeat(228) + "aa", 4],
+    ["😀".repeat(35), 1],
+    ["😀".repeat(99), 3],
+    ["😀".repeat(100), 4],
+  ])("%#: counts parts", (text, parts) => {
+    expect(smsParts(text)).toBe(parts);
+  });
+
+  it("caps a message at three parts", () => {
+    expect(SMS_MAX_PARTS).toBe(3);
+  });
+});
diff --git a/src/features/communication/smsParts.ts b/src/features/communication/smsParts.ts
new file mode 100644
index 0000000..3b6bb56
--- /dev/null
+++ b/src/features/communication/smsParts.ts
@@ -0,0 +1,29 @@
+// How many SMS parts a text takes, counted exactly as OAN Messaging counts it (contract 3.1.0, SMS-09).
+// One part holds 160 GSM-7 characters, or 70 when any character is outside GSM-7 (any Amharic letter or emoji).
+// A longer text is sent as concatenated parts of 153 / 67, and a two-unit character is never split between parts.
+
+const GSM7_BASIC = new Set(
+  "@£$¥èéùìòÇ\nØø\rÅåΔ_ΦΓΛΩΠΨΣΘΞÆæßÉ !\"#¤%&'()*+,-./0123456789:;<=>?¡ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÑÜ§¿abcdefghijklmnopqrstuvwxyzäöñüà",
+);
+const GSM7_EXTENSION = new Set("^{}\\[~]|€\f");
+
+/** OAN refuses an SMS longer than this many parts. */
+export const SMS_MAX_PARTS = 3;
+
+export function smsParts(text: string): number {
+  const chars = Array.from(text);
+  const gsm = chars.every((c) => GSM7_BASIC.has(c) || GSM7_EXTENSION.has(c));
+  const sizes = gsm ? chars.map((c) => (GSM7_EXTENSION.has(c) ? 2 : 1)) : chars.map((c) => c.length);
+  const [single, perPart] = gsm ? [160, 153] : [70, 67];
+  if (sizes.reduce((a, b) => a + b, 0) <= single) return 1;
+  let parts = 1;
+  let room = perPart;
+  for (const size of sizes) {
+    if (size > room) {
+      parts += 1;
+      room = perPart;
+    }
+    room -= size;
+  }
+  return parts;
+}
