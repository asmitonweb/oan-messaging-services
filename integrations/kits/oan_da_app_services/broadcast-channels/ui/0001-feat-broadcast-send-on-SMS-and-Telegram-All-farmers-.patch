@@ -114,3 +114,61 @@ export function broadcastToWoreda(input: BroadcastInput & { woredaCode: string }
 export function broadcastToKebele(input: BroadcastInput & { kebeleCode: string }): Promise<BroadcastResult> {
   return sendBroadcast(input, "kebele", input.kebeleCode);
 }
+
+export type BroadcastChannel = "in_app" | "sms" | "telegram";
+export type BroadcastLevel = "region" | "zone" | "woreda" | "kebele";
+
+export interface ChannelBroadcastInput {
+  /** "farmers": Communications Officer / Admin only, a whole Region, Zone or Woreda. "das": as the in-app broadcast. */
+  recipients: "farmers" | "das";
+  scope: BroadcastLevel;
+  /** Master Data code of the area, never its name. */
+  scopeValue: string;
+  channels: BroadcastChannel[];
+  title: string;
+  body?: string;
+  source?: string;
+  clientOpId?: string;
+}
+
+export interface ChannelBroadcastResult {
+  broadcastId: string;
+  duplicate: boolean;
+  state: string;
+  inApp?: { recipients: number };
+  sms?: { parts: number; queued: number; read: number };
+  telegram?: { recipients: number; sent?: number };
+}
+
+/**
+ * POST /da-services/broadcasts — the broadcast with its SMS and Telegram copies (da_broadcast_channels add-on).
+ * The send continues in the background: Telegram first, then the SMS copy to everyone not reached on Telegram.
+ * The same clientOpId returns the first result (duplicate=true); a different message under it is a 409.
+ */
+export async function sendChannelBroadcast(input: ChannelBroadcastInput): Promise<ChannelBroadcastResult> {
+  interface Resp {
+    data: {
+      broadcast_id: string;
+      duplicate: boolean;
+      state: string;
+      in_app?: { recipients: number };
+      sms?: { parts: number; queued: number; read: number };
+      telegram?: { recipients: number; sent?: number };
+    };
+  }
+  const res = await authRequest<Resp>("/da-services/broadcasts", {
+    method: "POST",
+    body: {
+      recipients: input.recipients,
+      scope: input.scope,
+      scope_value: input.scopeValue,
+      channels: input.channels,
+      title: input.title,
+      body: input.body ?? "",
+      source: input.source,
+      client_op_id: input.clientOpId ?? crypto.randomUUID(),
+    },
+  });
+  const d = res.data;
+  return { broadcastId: d.broadcast_id, duplicate: d.duplicate, state: d.state, inApp: d.in_app, sms: d.sms, telegram: d.telegram };
+}
