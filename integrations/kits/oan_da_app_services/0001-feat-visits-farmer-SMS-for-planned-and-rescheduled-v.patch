diff --git a/da_services/services/visit_sms.py b/da_services/services/visit_sms.py
new file mode 100644
index 0000000..d7c0376
--- /dev/null
+++ b/da_services/services/visit_sms.py
@@ -0,0 +1,110 @@
+"""Farmer SMS for planned and rescheduled visits, through the OAN Messaging Service.
+
+Sent only when the Development Agent ticked **Notify farmer by SMS**
+(``notify_farmer_sms``) on the visit, and only to the farmer: Development Agents are
+alerted on Telegram, not by SMS.
+
+=============  =====================================================================
+Event          Raised by
+=============  =====================================================================
+planned        ``services.visits.plan_visit``, after a new visit is inserted
+rescheduled    ``services.visits.reschedule_visit``, for the new visit it creates
+=============  =====================================================================
+
+Each event belongs to one visit row (a reschedule creates a new row), so
+``source_reference = da:visit:<visit>:<event>`` is unique per event, and an idempotent
+retry of ``plan_visit`` (same ``client_op_id``) inserts nothing and sends nothing.
+
+The message expires when the visit starts, capped inside OAN's 7-day horizon. A visit
+already started, closed or without a farmer phone sends nothing. ``queue_sms`` only adds
+an outbox row in this transaction; the connector sends it after commit and never raises.
+"""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime, timedelta
+from zoneinfo import ZoneInfo
+
+import frappe
+from frappe.utils import get_datetime, get_system_timezone
+from oan_messaging_connector.api import queue_sms
+from oan_messaging_connector.sms import fits_one_sms
+
+EVENTS = ("planned", "rescheduled")
+TEMPLATES = {
+	"planned": {
+		"en": "OAN: your Development Agent will visit you on {date} at {time}. Visit ref {visit}.",
+	},
+	"rescheduled": {
+		"en": "OAN: your Development Agent visit has moved to {date} at {time}. Visit ref {visit}.",
+	},
+}
+#: Longest values substituted; the tests render every template at these lengths.
+FIELD_LIMITS = {"date": 11, "time": 5, "visit": 20}
+OPEN_FOR_SMS = ("Planned", "Confirmed")
+#: OAN accepts an expiry at most 7 days ahead; stay a little inside it.
+MAX_EXPIRY_HORIZON = timedelta(days=7)
+EXPIRY_SAFETY_MARGIN = timedelta(minutes=5)
+
+
+class TemplateTooLong(ValueError):
+	"""The rendered text does not fit one SMS part."""
+
+
+def render(event: str, language: str = "en", **fields: str) -> str:
+	"""Render ``event``, falling back to English when there is no translation."""
+	for name, value in fields.items():
+		if name in FIELD_LIMITS and len(value) > FIELD_LIMITS[name]:
+			raise TemplateTooLong(f"{name} longer than {FIELD_LIMITS[name]} characters")
+	template = TEMPLATES[event].get(language) or TEMPLATES[event]["en"]
+	text = template.format(**fields)
+	if not fits_one_sms(text):
+		raise TemplateTooLong(f"{event}/{language} does not fit one SMS part")
+	return text
+
+
+def visit_deadline(starts_at: datetime, now: datetime) -> datetime | None:
+	"""When the message stops being useful; None when the visit has already started."""
+	deadline = min(starts_at, now + MAX_EXPIRY_HORIZON - EXPIRY_SAFETY_MARGIN)
+	return deadline if deadline > now else None
+
+
+def _farmer_phone(farmer_id: str | None) -> str | None:
+	"""The farmer's phone from the cached registry record (DA Farmer Reference)."""
+	if not farmer_id:
+		return None
+	phone = frappe.db.get_value("DA Farmer Reference", farmer_id, "phone")
+	return (phone or "").strip() or None
+
+
+def notify_farmer(visit, event: str) -> str | None:
+	"""Queue the farmer SMS for ``event`` on ``visit``; returns the OAN Message name or None."""
+	if event not in EVENTS or not visit.get("notify_farmer_sms"):
+		return None
+	if visit.get("physical_status") not in OPEN_FOR_SMS or not visit.get("scheduled_at"):
+		return None
+	tz = ZoneInfo(get_system_timezone())
+	local = get_datetime(visit.scheduled_at).replace(tzinfo=tz)
+	deadline = visit_deadline(local.astimezone(UTC), datetime.now(UTC))
+	if deadline is None:
+		return None
+	phone = _farmer_phone(visit.get("farmer_id"))
+	if not phone:
+		frappe.log_error(f"Visit SMS not queued for {visit.name}/{event}: no farmer phone", "OAN Messaging")
+		return None
+	try:
+		text = render(event, date=f"{local.day} {local:%b %Y}", time=f"{local:%H:%M}", visit=visit.name)
+	except TemplateTooLong as exc:
+		frappe.log_error(f"Visit SMS not queued for {visit.name}/{event}: {exc}", "OAN Messaging")
+		return None
+	return queue_sms(
+		recipient=phone,
+		text=text,
+		purpose="transactional",
+		source_reference=f"da:visit:{visit.name}:{event}",
+		reference_doctype="DA Visit",
+		reference_name=visit.name,
+		event=f"visit_{event}",
+		language="en",
+		expires_at=deadline,
+	)
