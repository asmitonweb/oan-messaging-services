diff --git a/da_services/tests/test_visit_sms.py b/da_services/tests/test_visit_sms.py
new file mode 100644
index 0000000..5695119
--- /dev/null
+++ b/da_services/tests/test_visit_sms.py
@@ -0,0 +1,132 @@
+"""Farmer SMS for planned and rescheduled visits (services/visit_sms.py).
+
+Drives the real plan and reschedule services; nothing is sent from here (the connector's
+own tests cover dispatch and polling).
+"""
+
+from datetime import UTC, datetime, timedelta
+from unittest import mock
+
+import frappe
+from frappe.tests import IntegrationTestCase
+from frappe.utils import add_days, add_to_date, now_datetime, today
+
+from da_services.services import constants as C
+from da_services.services import visit_sms, visits
+from da_services.tests.fixtures import (
+	cleanup_test_rows,
+	ensure_kebele_assignment,
+	live_geo,
+	set_da_registry_id,
+)
+from da_services.tests.test_visits import _grant, _user
+
+DA = "visit-sms-da@da.local"
+DA_ID = "DA-000001"
+FARMER = "FR-SMS-TEST-1"
+PHONE = "0900000741"
+
+
+class TestVisitSms(IntegrationTestCase):
+	def setUp(self):
+		frappe.set_user("Administrator")
+		cleanup_test_rows(users=(DA,), da_ids=(DA_ID,))
+		geo = live_geo()
+		_user(DA, [C.ROLE_DA])
+		set_da_registry_id(DA, DA_ID)
+		_grant(DA, C.ROLE_DA, da_id=DA_ID, region_scope=geo["region"], woreda_scope=geo["woreda"])
+		ensure_kebele_assignment(DA_ID, geo["kebele"])
+		if not frappe.db.exists("DA Farmer Reference", FARMER):
+			farmer = frappe.get_doc(
+				{
+					"doctype": "DA Farmer Reference",
+					"farmer_id": FARMER,
+					"farmer_name": "SMS Test",
+					"phone": PHONE,
+				}
+			)
+			farmer.flags.ignore_mandatory = True
+			farmer.insert(ignore_permissions=True)
+
+		keys = ("oan_messaging_enabled", "oan_messaging_base_url", "oan_messaging_token")
+		self._conf = {k: frappe.conf.get(k) for k in keys}
+		frappe.conf.oan_messaging_enabled = 1
+		frappe.conf.oan_messaging_base_url = "https://oan-messaging.example.invalid"
+		frappe.conf.oan_messaging_token = "oanmsg_" + "t" * 43
+		enqueue = mock.patch.object(frappe, "enqueue")  # no dispatch job from the tests
+		enqueue.start()
+		self.addCleanup(enqueue.stop)
+		self.tomorrow = f"{add_days(today(), 1)} 09:00:00"
+
+	def tearDown(self):
+		frappe.set_user("Administrator")
+		for k, v in self._conf.items():
+			frappe.conf[k] = v
+		visit_names = frappe.get_all("DA Visit", filters={"farmer_id": FARMER}, pluck="name")
+		if visit_names:
+			frappe.db.delete("OAN Message", {"reference_name": ["in", visit_names]})
+		frappe.db.delete("DA Farmer Reference", {"farmer_id": FARMER})
+		cleanup_test_rows(users=(DA,), da_ids=(DA_ID,))
+		frappe.db.commit()  # nosemgrep: frappe-semgrep-rules.rules.frappe-manual-commit
+
+	def plan(self, **kw):
+		args = {"farmer_id": FARMER, "scheduled_at": self.tomorrow, "user": DA, "notify_farmer_sms": True}
+		args.update(kw)
+		return visits.plan_visit(**args)
+
+	def messages(self, visit_name):
+		return frappe.get_all(
+			"OAN Message",
+			filters={"reference_doctype": "DA Visit", "reference_name": visit_name},
+			fields=["event", "recipient", "purpose", "source_reference", "expires_at", "text"],
+		)
+
+	def test_planned_visit_with_sms_ticked_queues_one_farmer_sms(self):
+		visit = self.plan()
+		(m,) = self.messages(visit["name"])
+		self.assertEqual((m.event, m.recipient, m.purpose), ("visit_planned", PHONE, "transactional"))
+		self.assertEqual(m.source_reference, f"da:visit:{visit['name']}:planned")
+		self.assertIn(visit["name"], m.text)
+		self.assertIsNotNone(m.expires_at)
+
+	def test_no_sms_unless_ticked(self):
+		visit = self.plan(notify_farmer_sms=False)
+		self.assertEqual(self.messages(visit["name"]), [])
+
+	def test_idempotent_replan_sends_nothing_new(self):
+		first = self.plan(client_op_id="op-visit-sms-1")
+		again = self.plan(client_op_id="op-visit-sms-1")
+		self.assertEqual(first["name"], again["name"])
+		self.assertEqual(len(self.messages(first["name"])), 1)
+
+	def test_reschedule_tells_the_farmer_the_new_time(self):
+		visit = self.plan()
+		new = visits.reschedule_visit(visit["name"], scheduled_at=f"{add_days(today(), 2)} 10:30:00")
+		(m,) = self.messages(new["name"])
+		self.assertEqual(m.event, "visit_rescheduled")
+		self.assertIn("10:30", m.text)
+		self.assertEqual(len(self.messages(visit["name"])), 1)  # the original keeps its one SMS
+
+	def test_past_visit_sends_nothing(self):
+		visit = self.plan(scheduled_at=add_to_date(now_datetime(), hours=-3))
+		self.assertEqual(self.messages(visit["name"]), [])
+
+	def test_no_farmer_phone_sends_nothing(self):
+		frappe.db.set_value("DA Farmer Reference", FARMER, "phone", "")
+		visit = self.plan()
+		self.assertEqual(self.messages(visit["name"]), [])
+
+	def test_deadline_is_capped_inside_the_expiry_horizon(self):
+		now = datetime.now(UTC)
+		self.assertEqual(visit_sms.visit_deadline(now + timedelta(days=2), now), now + timedelta(days=2))
+		self.assertEqual(
+			visit_sms.visit_deadline(now + timedelta(days=30), now),
+			now + visit_sms.MAX_EXPIRY_HORIZON - visit_sms.EXPIRY_SAFETY_MARGIN,
+		)
+		self.assertIsNone(visit_sms.visit_deadline(now - timedelta(minutes=1), now))
+
+	def test_every_template_fits_one_sms_at_maximum_field_lengths(self):
+		fields = {k: "W" * n for k, n in visit_sms.FIELD_LIMITS.items()}
+		for event, texts in visit_sms.TEMPLATES.items():
+			for language in texts:
+				visit_sms.render(event, language, **fields)  # raises TemplateTooLong if not
