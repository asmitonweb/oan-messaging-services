              "raw": "{\n  \"recipient\": \"{{recipient}}\",\n  \"text\": \"ሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀሀ\",\n  \"purpose\": \"transactional\",\n  \"source_reference\": \"{{sourceReference}}\",\n  \"expires_at\": \"{{expiresAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/sms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "messages",
                "sms"
              ]
            }
          }
        },
        {
          "name": "Purpose not granted",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('problem code is forbidden', () => pm.expect(pm.response.json().code).to.eql('forbidden'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{callerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "description": "403 `forbidden` (`purpose_not_permitted`) unless this caller was created with that purpose. Broadcast is also off until the deployment enables it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"{{recipient}}\",\n  \"text\": \"Weather advisory for your kebele.\",\n  \"purpose\": \"broadcast\",\n  \"source_reference\": \"{{sourceReference}}\",\n  \"expires_at\": \"{{expiresAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/sms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "messages",
                "sms"
              ]
            }
          }
        },
        {
          "name": "Same key, different body",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('problem code is idempotency_conflict', () => pm.expect(pm.response.json().code).to.eql('idempotency_conflict'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{callerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "X-Keep-Key",
                "value": "1",
                "description": "Reuse the previous request's key"
              }
            ],
            "description": "Run after any successful send: reuses its key with another body. 409 `idempotency_conflict`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"{{recipient}}\",\n  \"text\": \"A different text under a used key.\",\n  \"purpose\": \"transactional\",\n  \"source_reference\": \"{{sourceReference}}\",\n  \"expires_at\": \"{{expiresAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/sms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "messages",
                "sms"
              ]
            }
          }
        },
        {
          "name": "Status of an unknown id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
