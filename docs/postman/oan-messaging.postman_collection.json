            "description": "Run 'Send transactional' first, then this: it reuses that key with the same body. Expect 200 with the same message id and no second SMS. (Bodies must be byte-identical, including `source_reference` and `expires_at`, so run it straight after, before the variables change.)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"{{recipient}}\",\n  \"text\": \"Your grievance GRV-1024 has been resolved. Thank you for contacting OAN.\",\n  \"purpose\": \"transactional\",\n  \"source_reference\": \"{{sourceReference}}\",\n  \"expires_at\": \"{{expiresAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
