    {
      "name": "4. Telegram",
      "item": [
        {
          "name": "Send Telegram",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 202', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202 || pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('messageId', b.id);",
                  "  pm.collectionVariables.set('lastKey', b.idempotency_key);",
                  "  pm.test('response never carries the text', () => pm.expect(b).to.not.have.property('text'));",
                  "  pm.test('status is accepted', () => pm.expect(b.status).to.eql('accepted'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{callerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
